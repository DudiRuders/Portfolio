---
interface Props {
  current: 'etl' | 'document-automation' | 'kpi' | 'video-automation';
}

const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const cases = [
  { slug: 'etl', title: 'ETL Pipeline', tag: 'Python · Pandas' },
  { slug: 'document-automation', title: 'Document Automation', tag: 'n8n · Node.js' },
  { slug: 'kpi', title: 'Dashboard KPI', tag: 'Metabase · SQL' },
  { slug: 'video-automation', title: 'Dynamic Video Automation', tag: 'REST API · JSON' },
];
const index = cases.findIndex((c) => c.slug === Astro.props.current);
const next = cases[(index + 1) % cases.length];
---

<div class="read-progress" id="readProgress" aria-hidden="true"></div>

<nav class="mt-16 grid gap-4 sm:grid-cols-2 reveal" aria-label="Pozostałe case studies">
  <a href={`${root}/#projekty`} class="glass-card p-6 flex flex-col justify-center group">
    <span class="text-xs font-mono uppercase tracking-wider text-slate-500">← Wróć</span>
    <span class="mt-1 font-bold text-white group-hover:text-emerald-400 transition-colors">Wszystkie projekty</span>
  </a>
  <a href={`${root}/${next.slug}`} class="glass-card-accent p-6 flex flex-col items-end text-right group">
    <span class="text-xs font-mono uppercase tracking-wider text-emerald-400">Następne case study →</span>
    <span class="mt-1 text-lg font-bold text-white group-hover:text-emerald-400 transition-colors">{next.title}</span>
    <span class="mt-1 text-xs text-slate-500">{next.tag}</span>
  </a>
</nav>

<script>
  const bar = document.getElementById('readProgress');
  if (bar) {
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.setProperty('--progress', String(max > 0 ? Math.min(1, window.scrollY / max) : 0));
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
