---
interface Props {
  title: string;
  subtitle?: string;
  details?: string;
  delay?: string;
  boot?: string;
  href?: string;
  isComingSoon?: boolean;
  buttonText?: string;
}

const {
  title,
  subtitle,
  details,
  delay = "0s",
  boot = "0s",
  href = "/",
  isComingSoon = false,
  buttonText = "ZOBACZ PROJEKT"
} = Astro.props;

const base = import.meta.env.BASE_URL;
const isExternal = href.startsWith('http');
const link = isExternal ? href : `${base}${href}`.replace(/\/+/g, '/');
---

<div class="monitor-unit flex flex-col items-center w-full" style={`animation-delay: ${delay};`}>
  <div class="flex justify-between w-48 -mb-2 z-0 opacity-50">
    <div class="w-2 h-24 bg-gradient-to-b from-transparent via-slate-600 to-slate-700 shadow-xl"></div>
    <div class="w-2 h-24 bg-gradient-to-b from-transparent via-slate-600 to-slate-700 shadow-xl"></div>
  </div>

  <div class="relative z-10 p-4 bg-slate-800/80 rounded-3xl border-b-8 border-slate-900 shadow-2xl w-full max-w-[380px] transition-transform hover:scale-105 duration-300 backdrop-blur-sm group">

    <div class="crt-screen relative bg-[#080e1a] rounded-xl overflow-hidden border-4 border-slate-800 p-6 sm:p-8 flex flex-col items-center justify-center min-h-[220px]" style={`--boot: ${boot};`}>

      <div class="absolute inset-0 pointer-events-none opacity-20 bg-[linear-gradient(transparent_50%,rgba(0,0,0,1)_50%)] bg-[length:100%_4px]"></div>
      <div class="crt-sweep absolute inset-x-0 h-16 pointer-events-none"></div>

      <h3 class="glitch text-emerald-400 font-mono text-2xl sm:text-3xl font-black text-center mb-2 uppercase drop-shadow-[0_0_10px_rgba(16,185,129,0.8)] relative z-10 leading-snug" data-text={title}>
        {title}
      </h3>

      {subtitle && (
        <p class="text-emerald-300 font-mono text-sm font-bold text-center mb-4 uppercase relative z-10 tracking-widest">
          {subtitle}<span class="cursor" aria-hidden="true">_</span>
        </p>
      )}

      {details && (
        <p class="text-slate-300 font-mono text-sm text-center leading-relaxed relative z-10 mb-6">
          {details}
        </p>
      )}

      {isComingSoon ? (
        <div class="relative z-10 w-full text-center bg-slate-900 text-emerald-500/60 font-mono font-bold text-sm px-6 py-3 rounded border border-emerald-500/20 shadow-inner uppercase tracking-widest mt-auto">
          Już wkrótce
        </div>
      ) : (
        <a href={link} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noreferrer' : undefined} class="mt-auto relative z-10 w-full text-center bg-emerald-500 text-slate-950 font-mono font-bold text-sm px-6 py-3 rounded shadow-[0_0_15px_rgba(16,185,129,0.5)] hover:bg-emerald-400 hover:shadow-[0_0_25px_rgba(16,185,129,0.8)] transition-all uppercase cursor-pointer">
          {buttonText}
        </a>
      )}
    </div>

    <div class="power-led absolute bottom-5 right-8 w-3 h-3 bg-emerald-500 rounded-full animate-pulse shadow-[0_0_10px_rgba(16,185,129,1)]"></div>
  </div>
</div>

<style>
  .monitor-unit {
    animation: sway 6s ease-in-out infinite alternate;
    transform-origin: top center;
  }
  @keyframes sway {
    0% { transform: rotate(-1.5deg) translateX(-3px); }
    100% { transform: rotate(1.5deg) translateX(3px); }
  }

  /* Włączanie kineskopu: biała kreska, która rozwija się w obraz */
  .crt-screen > * { animation: crt-content 1.1s var(--boot) both; }
  .crt-screen { animation: crt-on 1.1s var(--boot) cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  @keyframes crt-on {
    0% { transform: scale(0.02, 0.004); filter: brightness(6); background: #d1fae5; }
    35% { transform: scale(1, 0.006); filter: brightness(4); background: #a7f3d0; }
    60% { transform: scale(1, 1); filter: brightness(1.6); }
    100% { transform: scale(1, 1); filter: brightness(1); }
  }
  @keyframes crt-content {
    0%, 55% { opacity: 0; }
    100% { opacity: 1; }
  }

  /* Pasek odświeżania przesuwający się po ekranie */
  .crt-sweep {
    top: -4rem;
    background: linear-gradient(transparent, rgba(16, 185, 129, 0.07), transparent);
    animation: sweep 5s linear infinite;
  }
  @keyframes sweep { to { transform: translateY(22rem); } }

  .cursor { animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* Glitch tytułu po najechaniu na monitor */
  .glitch { position: relative; }
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .glitch::before { color: #22d3ee; }
  .glitch::after { color: #f43f5e; }
  .group:hover .glitch::before { opacity: 0.7; animation: glitch-a 0.6s steps(2) infinite; }
  .group:hover .glitch::after { opacity: 0.7; animation: glitch-b 0.6s steps(2) infinite; }
  @keyframes glitch-a {
    0% { transform: translate(-2px, 0); clip-path: inset(0 0 60% 0); }
    50% { transform: translate(2px, -1px); clip-path: inset(40% 0 20% 0); }
    100% { transform: translate(-1px, 1px); clip-path: inset(70% 0 0 0); }
  }
  @keyframes glitch-b {
    0% { transform: translate(2px, 0); clip-path: inset(50% 0 10% 0); }
    50% { transform: translate(-2px, 1px); clip-path: inset(0 0 70% 0); }
    100% { transform: translate(1px, -1px); clip-path: inset(20% 0 50% 0); }
  }

  /* Kot mruczy na turbo: wszystkie ekrany pulsują */
  :global(body.purr) .crt-screen { animation: purr-flash 0.35s ease-in-out 6 alternate; }
  @keyframes purr-flash { to { box-shadow: inset 0 0 40px rgba(16, 185, 129, 0.6); filter: brightness(1.4); } }

  @media (prefers-reduced-motion: reduce) {
    .monitor-unit, .crt-screen, .crt-screen > *, .crt-sweep, .cursor { animation: none; }
  }
</style>
