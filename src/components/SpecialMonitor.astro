---
interface Props {
  title: string;
  subtitle?: string;
  details?: string;
  delay?: string;
  href?: string;
  isComingSoon?: boolean;
  buttonText?: string;
}

const { 
  title, 
  subtitle, 
  details, 
  delay = "0s", 
  href = "/", 
  isComingSoon = false, 
  buttonText = "ZOBACZ PROJEKT" 
} = Astro.props;

const base = import.meta.env.BASE_URL;
const link = href.startsWith('http') ? href : `${base}${href}`.replace(/\/+/g, '/');
---

<div class="monitor-unit flex flex-col items-center" style={`animation-delay: ${delay};`}>
  <div class="flex justify-between w-48 -mb-2 z-0 opacity-50">
    <div class="w-2 h-24 bg-gradient-to-b from-transparent via-slate-600 to-slate-700 shadow-xl"></div>
    <div class="w-2 h-24 bg-gradient-to-b from-transparent via-slate-600 to-slate-700 shadow-xl"></div>
  </div>

  <div class="relative z-10 p-4 bg-slate-800/80 rounded-3xl border-b-8 border-slate-900 shadow-2xl w-[380px] transition-transform hover:scale-105 duration-300 backdrop-blur-sm">
    
    <div class="relative bg-[#080e1a] rounded-xl overflow-hidden border-4 border-slate-800 p-8 flex flex-col items-center justify-center min-h-[220px]">
      
      <div class="absolute inset-0 pointer-events-none opacity-20 bg-[linear-gradient(transparent_50%,rgba(0,0,0,1)_50%)] bg-[length:100%_4px]"></div>

      <h3 class="text-emerald-400 font-mono text-3xl font-black text-center mb-2 uppercase drop-shadow-[0_0_10px_rgba(16,185,129,0.8)] relative z-10 leading-snug">
        {title}
      </h3>

      {subtitle && (
        <p class="text-emerald-300 font-mono text-sm font-bold text-center mb-4 uppercase relative z-10 tracking-widest">
          {subtitle}
        </p>
      )}

      {details && (
        <p class="text-slate-300 font-mono text-sm text-center leading-relaxed relative z-10 mb-6">
          {details}
        </p>
      )}

      {isComingSoon ? (
        <div class="relative z-10 w-full text-center bg-slate-900 text-emerald-500/60 font-mono font-bold text-sm px-6 py-3 rounded border border-emerald-500/20 shadow-inner uppercase tracking-widest mt-auto">
          Już wkrótce
        </div>
      ) : (
        <a href={link} class="mt-auto relative z-10 w-full text-center bg-emerald-500 text-slate-950 font-mono font-bold text-sm px-6 py-3 rounded shadow-[0_0_15px_rgba(16,185,129,0.5)] hover:bg-emerald-400 hover:shadow-[0_0_25px_rgba(16,185,129,0.8)] transition-all uppercase cursor-pointer">
          {buttonText}
        </a>
      )}
    </div>

    <div class="absolute bottom-5 right-8 w-3 h-3 bg-emerald-500 rounded-full animate-pulse shadow-[0_0_10px_rgba(16,185,129,1)]"></div>
  </div>
</div>

<style>
  .monitor-unit {
    animation: sway 6s ease-in-out infinite alternate;
    transform-origin: top center;
  }
  @keyframes sway {
    0% { transform: rotate(-1.5deg) translateX(-3px); }
    100% { transform: rotate(1.5deg) translateX(3px); }
  }
</style>