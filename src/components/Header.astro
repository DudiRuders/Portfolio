---
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${root}/#projekty`, label: 'Projekty' },
  { href: `${root}/#po-godzinach`, label: 'Po godzinach' },
  { href: `${root}/#stack`, label: 'Stack' },
  { href: `${root}/#jak-pracuje`, label: 'Jak pracuję' },
  { href: `${root}/#kontakt`, label: 'Kontakt' },
];
---

<header class="sticky top-0 z-50 header-glass">
  <div class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between">

    <a href={`${root}/`} class="flex items-center gap-3 group">
      <span class="monogram">MW</span>
      <span class="hidden sm:block text-sm font-medium text-slate-400 group-hover:text-slate-200 transition-colors">
        <span class="text-slate-200 font-semibold">Mateusz Wienskowski</span><span class="text-slate-600">/portfolio</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-400" aria-label="Nawigacja główna">
      {links.map((link) => <a class="nav-link" href={link.href}>{link.label}</a>)}
    </nav>

    <a href={`mailto:mateusz.wienskowski@onet.pl`} class="btn-neon !py-2 !px-4 !text-xs">
      <span>Napisz</span>
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>

  <!-- Na telefonie: przewijany pasek zamiast ukrytego menu -->
  <nav class="md:hidden mobile-nav" aria-label="Nawigacja główna">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>

<script>
  // Podświetla w nawigacji sekcję, która jest właśnie na ekranie (tylko strona główna)
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav-link, .mobile-nav a')];
  const sections = [...new Set(navLinks.map((a) => a.hash.slice(1)))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((a) => a.classList.toggle('is-active', a.hash === `#${entry.target.id}`));
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    sections.forEach((s) => observer.observe(s));
  }
</script>

<style>
  .header-glass {
    background: rgba(11, 17, 32, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(16, 185, 129, 0.08);
  }

  .monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.625rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 800;
    font-size: 0.75rem;
    color: #34D399;
    transition: all 0.3s;
  }

  .monogram:hover {
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
    border-color: rgba(16, 185, 129, 0.4);
  }

  .nav-link {
    position: relative;
    padding-bottom: 2px;
    transition: color 0.3s;
  }
  .nav-link:hover { color: #E2E8F0; }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: #10B981;
    border-radius: 2px;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after { width: 100%; }
  .nav-link.is-active { color: #E2E8F0; }

  .mobile-nav {
    display: flex;
    gap: 0.5rem;
    padding: 0 1rem 0.625rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .mobile-nav::-webkit-scrollbar { display: none; }
  .mobile-nav a {
    flex-shrink: 0;
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #94A3B8;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    transition: color 0.2s, border-color 0.2s;
  }
  .mobile-nav a:hover, .mobile-nav a:focus-visible, .mobile-nav a.is-active { color: #34D399; border-color: rgba(16, 185, 129, 0.35); }
  @media (min-width: 768px) { .mobile-nav { display: none; } }
</style>
