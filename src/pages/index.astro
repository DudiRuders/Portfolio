---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- ═══ HERO ═══ -->
  <section class="mx-auto max-w-6xl px-4 pt-24 pb-32 md:pt-36 md:pb-44 flex flex-col items-start text-left">
    
    <div class="flex flex-wrap items-center gap-3 mb-8 reveal">
      <a href="/Portfolio/nicpon" title="Access System" class="badge-neon cursor-crosshair hover:border-emerald-400/40 transition-colors">
        <span class="badge-dot"></span>
        Intelligent Automation
      </a>
      <span class="badge-neon">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        AI Systems
      </span>
    </div>

    <h1 class="text-4xl md:text-6xl lg:text-7xl font-black tracking-tight leading-[1.08] reveal reveal-delay-1">
      <span class="text-slate-100">Automatyzuję</span> <br class="hidden md:block" />
      <span class="neon-text">marketing i biznes.</span>
    </h1>

    <p class="mt-6 max-w-2xl text-lg md:text-xl text-slate-400 leading-relaxed reveal reveal-delay-2">
      Projektuję rozwiązania, które przyspieszają pracę zespołów. Od porządkowania danych i integracji API, po inteligentne raportowanie z wykorzystaniem AI. Mniej ręcznej pracy, zero błędów.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4 reveal reveal-delay-3">
      <a href="#projekty" class="btn-neon">
        <span>Zobacz projekty</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
      <a href="#kontakt" class="btn-ghost">Napisz do mnie</a>
    </div>
  </section>

  <!-- ═══ PROJEKTY ═══ -->
  <div class="section-divider"></div>
  <section id="projekty" class="mx-auto max-w-6xl px-4 py-20 md:py-28">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 reveal">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Wybrane projekty</h2>
        <p class="mt-3 text-slate-400 max-w-3xl">Automatyzacje i architektura danych, które zbudowałem. Skupiam się na realnym efekcie biznesowym.</p>
      </div>
      <a href="https://github.com/dudiruders" target="_blank" rel="noreferrer" class="group flex items-center gap-2 text-sm font-semibold text-emerald-400 hover:text-white transition-colors">
        Zobacz więcej na GitHub
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      
      <article class="glass-card p-8 flex flex-col items-start justify-between group relative reveal reveal-delay-1">
        <div class="project-number mb-2">01</div>
        <div>
          <h3 class="font-bold text-xl text-white group-hover:text-emerald-400 transition-colors">ETL</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">Pipeline do normalizacji nazw, gramatur, skrótów i błędów w danych produktowych z wielu działów.</p>
          <div class="mt-6 flex flex-wrap gap-2">
            <span class="tech-tag">Python</span>
            <span class="tech-tag">Pandas</span>
            <span class="tech-tag">PostgreSQL</span>
          </div>
        </div>
        <a href="/Portfolio/etl" class="mt-8 text-sm font-semibold text-emerald-400 inline-flex items-center gap-1">
          Case study <span class="group-hover:translate-x-1 transition-transform">→</span>
          <span class="absolute inset-0"></span>
        </a>
      </article>

      <article class="glass-card p-8 flex flex-col items-start justify-between group relative reveal reveal-delay-2">
        <div class="project-number mb-2">02</div>
        <div>
          <h3 class="font-bold text-xl text-white group-hover:text-emerald-400 transition-colors">Document-automation</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">Inteligentna automatyzacja dokumentów. Pobieranie danych, szablony, generowanie PDF i synchronizacja statusów.</p>
          <div class="mt-6 flex flex-wrap gap-2">
            <span class="tech-tag">n8n</span>
            <span class="tech-tag">API</span>
            <span class="tech-tag">Airtable</span>
          </div>
        </div>
        <a href="/Portfolio/document-automation" class="mt-8 text-sm font-semibold text-emerald-400 inline-flex items-center gap-1">
          Case study <span class="group-hover:translate-x-1 transition-transform">→</span>
          <span class="absolute inset-0"></span>
        </a>
      </article>

      <article class="glass-card p-8 flex flex-col items-start justify-between group relative reveal reveal-delay-3">
        <div class="project-number mb-2">03</div>
        <div>
          <h3 class="font-bold text-xl text-white group-hover:text-emerald-400 transition-colors">Dashboard KPI</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">Jedno źródło prawdy. Raportowanie, alerty i trendy dla marketingu oraz zarządu w Metabase.</p>
          <div class="mt-6 flex flex-wrap gap-2">
            <span class="tech-tag">Metabase</span>
            <span class="tech-tag">SQL</span>
            <span class="tech-tag">PostgreSQL</span>
          </div>
        </div>
        <a href="/Portfolio/kpi" class="mt-8 text-sm font-semibold text-emerald-400 inline-flex items-center gap-1">
          Case study <span class="group-hover:translate-x-1 transition-transform">→</span>
          <span class="absolute inset-0"></span>
        </a>
      </article>

      <!-- Featured -->
      <article class="md:col-span-3 gradient-border reveal reveal-delay-4">
        <div class="glass-card-accent flex flex-col md:flex-row items-start md:items-center justify-between gap-8 p-8 md:p-10 !rounded-[1.2rem] relative overflow-hidden group">
          <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-emerald-500/8 blur-3xl group-hover:bg-emerald-500/15 transition-all duration-500"></div>
          <div class="relative flex-1">
            <div class="badge-neon mb-4">
              <span class="badge-dot"></span>
              ✨ Wyróżniony projekt
            </div>
            <h3 class="font-bold text-2xl md:text-3xl text-white group-hover:text-emerald-400 transition-colors">Dynamic Video Automation</h3>
            <p class="mt-3 text-base md:text-lg text-slate-300 leading-relaxed max-w-3xl">Programistyczne generowanie tysięcy spersonalizowanych spotów wideo (MP4) poprzez REST API i dynamiczne payloady JSON. Koniec z ręcznym montażem i błędami w cenach.</p>
            <div class="mt-6 flex flex-wrap gap-2">
              <span class="tech-tag">JSON Payload</span>
              <span class="tech-tag">REST API</span>
              <span class="tech-tag">Creative Automation</span>
            </div>
          </div>
          <div class="relative mt-2 md:mt-0 shrink-0">
            <a href="/Portfolio/video-automation" class="btn-neon z-10 relative">
              <span>Case study</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ═══ W CZYM POMAGAM ═══ -->
  <div class="section-divider"></div>
  <section id="co-robie" class="mx-auto max-w-6xl px-4 py-20 md:py-28">
    <div class="mb-12 reveal">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">W czym pomagam</h2>
      <p class="mt-3 text-slate-400 max-w-2xl">Łączę systemy i buduję workflow, które oszczędzają czas. Podejście best-tool-for-the-job.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-3 md:grid-rows-2">
      <div class="md:col-span-2 glass-card-accent p-8 reveal reveal-delay-1">
        <h3 class="font-bold text-xl text-white flex items-center gap-3">
          <span class="text-2xl">✨</span> Integracja narzędzi AI
        </h3>
        <p class="mt-3 text-slate-300 leading-relaxed">Dobieram modele i narzędzia do zadania. Wdrażam asystentów, automatyzuję ekstrakcję informacji, klasyfikację danych, standaryzację promptów oraz generowanie treści. Łączę AI z procesami biznesowymi (Workflow Automation, Webhooki, API).</p>
      </div>
      <div class="glass-card p-8 reveal reveal-delay-2">
        <h3 class="font-bold text-lg text-white">Marketing Automation</h3>
        <p class="mt-2 text-sm text-slate-400">Kampanie, harmonogramy, integracje API z SaaS. Redukcja ręcznych powtarzalnych czynności w zespole.</p>
      </div>
      <div class="glass-card p-8 reveal reveal-delay-1">
        <h3 class="font-bold text-lg text-white">ETL i czyszczenie danych</h3>
        <p class="mt-2 text-sm text-slate-400">Łączenie danych z wielu źródeł w jeden użyteczny model. Skrypty Python/Pandas do czyszczenia i mapowania.</p>
      </div>
      <div class="glass-card p-8 reveal reveal-delay-2">
        <h3 class="font-bold text-lg text-white">Backend & Logika</h3>
        <p class="mt-2 text-sm text-slate-400">Pisanie mikroserwisów (FastAPI/Django), webhooki do komunikacji między systemami, reguły scoringowe.</p>
      </div>
      <div class="glass-card p-8 reveal reveal-delay-3">
        <h3 class="font-bold text-lg text-white">Raportowanie & BI</h3>
        <p class="mt-2 text-sm text-slate-400">Dashboardy i KPI dla zarządu w Metabase. Automatyczne raporty, powiadomienia i jedno źródło prawdy.</p>
      </div>
    </div>
  </section>

  <!-- ═══ STACK ═══ -->
  <div class="section-divider"></div>
  <section id="stack" class="mx-auto max-w-6xl px-4 py-20 md:py-28">
    <div class="mb-12 reveal">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Stack technologiczny</h2>
      <p class="mt-3 text-slate-400 max-w-2xl">Narzędzia to tylko środek do celu, ale dobrze jest wiedzieć, co mam w skrzynce.</p>
    </div>
    <div class="grid gap-8 md:grid-cols-3 reveal">
      <div class="glass-card p-8">
        <h3 class="font-bold text-lg text-white mb-5 flex items-center gap-2">
          <span class="text-emerald-500">⚡</span> Automatyzacja
        </h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> n8n & Make & Zapier</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> Webhooks & Integracje API</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> Airtable & Smartsuite</li>
        </ul>
      </div>
      <div class="glass-card p-8">
        <h3 class="font-bold text-lg text-white mb-5 flex items-center gap-2">
          <span class="text-emerald-500">💾</span> Backend & Dane
        </h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> Python (Pandas, ETL)</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> Django & FastAPI</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> PostgreSQL & SQL</li>
        </ul>
      </div>
      <div class="glass-card p-8">
        <h3 class="font-bold text-lg text-white mb-5 flex items-center gap-2">
          <span class="text-emerald-500">🛠️</span> Dev & Prezentacja
        </h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> AI & LLMs (Prompt Engineering)</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> Docker & GitHub Actions</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> HTML / Tailwind / Astro</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ JAK PRACUJĘ ═══ -->
  <div class="section-divider"></div>
  <section id="jak-pracuje" class="py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-16 max-w-4xl reveal">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Jak pracuję</h2>
        <p class="mt-3 text-slate-400">Zamiast od razu pisać kod, zaczynam od zrozumienia problemu. Mój proces gwarantuje, że wdrażamy to, co naprawdę działa.</p>
      </div>

      <div class="relative ml-3 md:ml-6 space-y-10 pb-4 reveal">
        <div class="absolute left-0 top-0 bottom-0 w-px bg-gradient-to-b from-emerald-500/50 via-emerald-500/20 to-transparent"></div>
        
        <div class="relative pl-8 md:pl-12">
          <div class="absolute -left-[7px] top-1 h-3.5 w-3.5 rounded-full bg-emerald-500/15 border-2 border-emerald-500/40"></div>
          <h3 class="font-bold text-xl text-white">1. Analiza procesu</h3>
          <p class="mt-2 text-slate-400 leading-relaxed">Mapuję przepływ informacji, identyfikuję punkty bólu, wąskie gardła i sprawdzam jakość źródeł danych.</p>
        </div>
        <div class="relative pl-8 md:pl-12">
          <div class="absolute -left-[7px] top-1 h-3.5 w-3.5 rounded-full bg-emerald-500/15 border-2 border-emerald-500/40"></div>
          <h3 class="font-bold text-xl text-white">2. Projekt rozwiązania</h3>
          <p class="mt-2 text-slate-400 leading-relaxed">Dobieram odpowiedni stack technologiczny, planuję architekturę workflow oraz bezpieczne integracje systemów.</p>
        </div>
        <div class="relative pl-8 md:pl-12">
          <div class="absolute -left-[7px] top-1 h-3.5 w-3.5 rounded-full bg-emerald-500 border-2 border-emerald-400 shadow-[0_0_12px_rgba(16,185,129,0.5)]"></div>
          <h3 class="font-bold text-xl text-white">3. Implementacja <span class="text-emerald-400 ml-2 text-sm font-normal uppercase tracking-wider">Core</span></h3>
          <p class="mt-2 text-slate-400 leading-relaxed">Tworzę rozwiązania backendowe i automatyzacyjne, kierując się zasadą "best-tool-for-the-job". Buduję logikę błędów i weryfikacji.</p>
        </div>
        <div class="relative pl-8 md:pl-12">
          <div class="absolute -left-[7px] top-1 h-3.5 w-3.5 rounded-full bg-emerald-500/15 border-2 border-emerald-500/40"></div>
          <h3 class="font-bold text-xl text-white">4. Raportowanie & Dokumentacja</h3>
          <p class="mt-2 text-slate-400 leading-relaxed">Tworzę dashboardy KPI wspierające decyzje biznesowe. Dostarczam README, instrukcje i checklisty wdrożeń dla zespołu.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ KONTAKT ═══ -->
  <div class="section-divider"></div>
  <section id="kontakt" class="mx-auto max-w-4xl px-4 py-24 text-center reveal">
    <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white">
      Gotowy na <span class="neon-text">optymalizację?</span>
    </h2>
    <p class="mt-4 text-lg text-slate-400 max-w-2xl mx-auto">Porozmawiajmy o tym, jak inteligentna automatyzacja i AI mogą przyspieszyć procesy w Twojej firmie.</p>
    
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="mailto:mateusz.wienskowski@onet.pl" data-umami-event="StronaGlowna_NapiszEmail" class="btn-neon w-full sm:w-auto !px-8 !py-4 !text-base">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
        <span>Napisz email</span>
      </a>
      <a href="/Portfolio/oferta" data-umami-event="StronaGlowna_ZobaczB2B" class="btn-ghost w-full sm:w-auto !px-8 !py-4 !text-base">
        <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
        <span>Zobacz ofertę B2B</span>
      </a>
    </div>

    <div class="mt-12 flex justify-center gap-6">
      <a href="https://github.com/dudiruders" target="_blank" rel="noreferrer" class="text-slate-500 hover:text-emerald-400 transition-colors">
        <span class="sr-only">GitHub</span>
        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
      </a>
      <a href="https://www.linkedin.com/in/mateusz-wienskowski" class="text-slate-500 hover:text-emerald-400 transition-colors">
        <span class="sr-only">LinkedIn</span>
        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>
