---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import factorioImg from '../assets/gry/factorio.webp';
import starruptureImg from '../assets/gry/starrupture.webp';
import psychotestImg from '../assets/gry/psychotest.webp';

const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const gh = 'https://github.com/DudiRuders';

const repos = [
  { name: 'ETL-product-normalization', lang: 'Python', desc: 'Czyszczenie i normalizacja danych produktowych: Pandas i Regex, raport kwarantanny, opcjonalny zapis do PostgreSQL i testy w pytest.' },
  { name: 'document-automation-engine', lang: 'n8n', desc: 'Orkiestrator dokumentów: trigger z Airtable, payload JSON, gotowy PDF na Google Drive.' },
  { name: 'document-render-service', lang: 'Node.js', desc: 'Mikroserwis Express: render DOCX z JSON, podmiana obrazów i pieczątki na PDF. W Dockerze.' },
  { name: 'excel-to-docx-pipeline', lang: 'Python', desc: 'Demo w Pythonie: dane z arkusza Excel lecą do Render API i wracają jako gotowy dokument Word z tabelą i podmienionym logo.' },
  { name: 'creative-automation-engine', lang: 'n8n + API', desc: 'Wideo jako szablon: payload JSON zamienia się w MP4 w trzech formatach przez Creatomate.' },
  { name: 'KPI', lang: 'SQL', desc: 'Metabase na PostgreSQL: widoki SQL, alerty KPI i środowisko w docker-compose.' },
];

const games = [
  {
    title: 'Factorio Calc Pro',
    kicker: 'Kalkulator · Factorio 2.0',
    img: factorioImg,
    href: `${root}/gry/factorio/index.html`,
    code: `${gh}/Gry/tree/main/factorio`,
    accent: '#f59e0b',
    event: 'Gry_Factorio',
    desc: 'Ile maszyn postawić, ile surowców podać i ile taśm to zje. Gotowe receptury, maszyny ze Space Age, moduły, beacony i link do układu dla ekipy.',
    tags: ['Vanilla JS', 'Space Age', 'Stan w URL'],
  },
  {
    title: 'StarRupture Planner',
    kicker: 'Kalkulator · StarRupture',
    img: starruptureImg,
    href: `${root}/gry/starrupture/index.html`,
    code: `${gh}/Gry/tree/main/starrupture`,
    accent: '#ff8a3d',
    event: 'Gry_StarRupture',
    desc: 'Planowanie linii produkcyjnych: tempo maszyny z cyklu albo prosto z gry, liczba maszyn do celu i zapotrzebowanie na każde wejście.',
    tags: ['Vanilla JS', 'Wiele wejść', 'Kopiuj podsumowanie'],
  },
  {
    title: 'BRAVVM: psychotest',
    kicker: 'Quiz · Warhammer 40,000: Darktide',
    img: psychotestImg,
    href: `${root}/gry/darktide-psychotest/index.html`,
    code: `${gh}/Gry/tree/main/darktide-bravo-psychotest`,
    accent: '#ff2d87',
    event: 'Gry_Psychotest',
    desc: 'Psychotest jak z gazetki Bravo, tylko o Darktide. 14 pytań, 7 klas i plakat XXL z akwilą, który drukuje się na jednej kartce A4.',
    tags: ['Grafika SVG od zera', 'Zbalansowana punktacja', 'Druk A4'],
  },
];
---

<BaseLayout>
  <!-- ═══ HERO ═══ -->
  <section class="mx-auto max-w-6xl px-4 pt-24 pb-28 md:pt-36 md:pb-40 grid gap-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-center">
   <div class="flex flex-col items-start text-left">

    <div class="flex flex-wrap items-center gap-3 mb-8 reveal">
      <a href={`${root}/nicpon`} title="Access System" class="badge-neon cursor-crosshair hover:border-emerald-400/40 transition-colors">
        <span class="badge-dot"></span>
        Intelligent Automation
      </a>
      <span class="badge-neon">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        AI Systems
      </span>
    </div>

    <h1 class="text-4xl md:text-6xl lg:text-7xl font-black tracking-tight leading-[1.08] reveal reveal-delay-1">
      <span class="text-slate-100">Automatyzuję</span> <br class="hidden md:block" />
      <span class="neon-text">marketing i biznes.</span>
    </h1>

    <p class="mt-6 max-w-2xl text-lg md:text-xl text-slate-400 leading-relaxed reveal reveal-delay-2">
      Projektuję rozwiązania, które przyspieszają pracę zespołów: od porządkowania danych i integracji API po raportowanie wspierane przez AI. Mniej ręcznej pracy i mniej błędów.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4 reveal reveal-delay-3">
      <a href="#projekty" class="btn-neon">
        <span>Zobacz projekty</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
      <a href="#kontakt" class="btn-ghost">Napisz do mnie</a>
    </div>

    <dl class="mt-14 grid grid-cols-2 sm:grid-cols-4 gap-x-10 gap-y-6 reveal reveal-delay-4">
      <div class="flex flex-col-reverse"><dt class="metric-label">repozytoriów na GitHubie</dt><dd class="metric-value !text-3xl">7</dd></div>
      <div class="flex flex-col-reverse"><dt class="metric-label">case studies</dt><dd class="metric-value !text-3xl">4</dd></div>
      <div class="flex flex-col-reverse"><dt class="metric-label">systemy w produkcji</dt><dd class="metric-value !text-3xl">4+</dd></div>
      <div class="flex flex-col-reverse"><dt class="metric-label">projekty po godzinach</dt><dd class="metric-value !text-3xl">3</dd></div>
    </dl>
   </div>

    <!-- Konsola: podsumowanie tego, co robią projekty z portfolio -->
    <div class="hidden lg:block reveal reveal-delay-2" aria-hidden="true">
      <div class="hero-console code-window">
        <div class="code-window-header">
          <div class="code-window-dots"><span></span><span></span><span></span></div>
          <span class="code-window-title">pipeline.log</span>
        </div>
        <div class="p-5 font-mono text-[13px] leading-7">
          <p class="text-slate-500">observer@portfolio:~$ <span class="text-slate-200">make run-all</span></p>
          <ul>
          <li class="console-line" style="--i:0"><span class="text-emerald-400">✓</span><span class="console-job">etl</span><span class="text-slate-400">6 czystych · 1 w kwarantannie</span></li>
          <li class="console-line" style="--i:1"><span class="text-emerald-400">✓</span><span class="console-job">render-api</span><span class="text-slate-400">POST /render → rendered.docx</span></li>
          <li class="console-line" style="--i:2"><span class="text-emerald-400">✓</span><span class="console-job">render-api</span><span class="text-slate-400">POST /stamp → stamped.pdf</span></li>
          <li class="console-line" style="--i:3"><span class="text-emerald-400">✓</span><span class="console-job">creative</span><span class="text-slate-400">payload → MP4 · 1:1 · 9:16 · 16:9</span></li>
          <li class="console-line" style="--i:4"><span class="text-emerald-400">✓</span><span class="console-job">kpi</span><span class="text-slate-400">MoM growth · sales_kpi_logic.sql</span></li>
          <li class="console-line" style="--i:5"><span class="console-run">●</span><span class="console-job">nicpoń</span><span class="text-slate-400">nadzoruje produkcję…</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PROJEKTY ═══ -->
  <div class="section-divider"></div>
  <section id="projekty" class="mx-auto max-w-6xl px-4 py-20 md:py-28">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 reveal">
      <div>
        <p class="section-kicker">01 / Projekty</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Wybrane projekty</h2>
        <p class="mt-3 text-slate-400 max-w-3xl">Automatyzacje i architektura danych, które zbudowałem. Każdy projekt ma case study i kod na GitHubie.</p>
      </div>
      <a href={gh} target="_blank" rel="noreferrer" class="group flex items-center gap-2 text-sm font-semibold text-emerald-400 hover:text-white transition-colors">
        Profil na GitHubie
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">

      <article class="glass-card p-8 flex flex-col items-start justify-between group relative reveal reveal-delay-1">
        <div class="project-number mb-2">01</div>
        <div>
          <h3 class="font-bold text-xl text-white group-hover:text-emerald-400 transition-colors">ETL Pipeline</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">Normalizacja nazw, gramatur, skrótów i literówek w danych produktowych z czterech działów. 12 tys. rekordów w około 2 sekundy.</p>
          <div class="mt-6 flex flex-wrap gap-2">
            <span class="tech-tag">Python</span>
            <span class="tech-tag">Pandas</span>
            <span class="tech-tag">PostgreSQL</span>
          </div>
        </div>
        <a href={`${root}/etl`} class="mt-8 text-sm font-semibold text-emerald-400 inline-flex items-center gap-1">
          Case study <span class="group-hover:translate-x-1 transition-transform">→</span>
          <span class="absolute inset-0"></span>
        </a>
      </article>

      <article class="glass-card p-8 flex flex-col items-start justify-between group relative reveal reveal-delay-2">
        <div class="project-number mb-2">02</div>
        <div>
          <h3 class="font-bold text-xl text-white group-hover:text-emerald-400 transition-colors">Document Automation</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">Umowy i raporty bez kopiuj-wklej. Orkiestrator n8n, własne Render API w Node.js i demo z Excela: trzy repozytoria, jeden system.</p>
          <div class="mt-6 flex flex-wrap gap-2">
            <span class="tech-tag">n8n</span>
            <span class="tech-tag">Node.js</span>
            <span class="tech-tag">Docker</span>
          </div>
        </div>
        <a href={`${root}/document-automation`} class="mt-8 text-sm font-semibold text-emerald-400 inline-flex items-center gap-1">
          Case study <span class="group-hover:translate-x-1 transition-transform">→</span>
          <span class="absolute inset-0"></span>
        </a>
      </article>

      <article class="glass-card p-8 flex flex-col items-start justify-between group relative reveal reveal-delay-3">
        <div class="project-number mb-2">03</div>
        <div>
          <h3 class="font-bold text-xl text-white group-hover:text-emerald-400 transition-colors">Dashboard KPI</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">Jedno źródło prawdy zamiast kilkunastu Exceli. Dashboardy, alerty i trendy dla marketingu oraz zarządu w Metabase.</p>
          <div class="mt-6 flex flex-wrap gap-2">
            <span class="tech-tag">Metabase</span>
            <span class="tech-tag">SQL</span>
            <span class="tech-tag">PostgreSQL</span>
          </div>
        </div>
        <a href={`${root}/kpi`} class="mt-8 text-sm font-semibold text-emerald-400 inline-flex items-center gap-1">
          Case study <span class="group-hover:translate-x-1 transition-transform">→</span>
          <span class="absolute inset-0"></span>
        </a>
      </article>

      <!-- Featured -->
      <article class="md:col-span-3 gradient-border reveal reveal-delay-4">
        <div class="glass-card-accent flex flex-col md:flex-row items-start md:items-center justify-between gap-8 p-8 md:p-10 !rounded-[1.2rem] relative overflow-hidden group">
          <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-emerald-500/8 blur-3xl group-hover:bg-emerald-500/15 transition-all duration-500"></div>
          <div class="relative flex-1">
            <div class="badge-neon mb-4">
              <span class="badge-dot"></span>
              ✨ Wyróżniony projekt
            </div>
            <h3 class="font-bold text-2xl md:text-3xl text-white group-hover:text-emerald-400 transition-colors">Dynamic Video Automation</h3>
            <p class="mt-3 text-base md:text-lg text-slate-300 leading-relaxed max-w-3xl">Setki spersonalizowanych spotów wideo (MP4) generowanych z danych przez REST API i payloady JSON. Koniec z ręcznym montażem i literówkami w cenach.</p>
            <div class="mt-6 flex flex-wrap gap-2">
              <span class="tech-tag">JSON Payload</span>
              <span class="tech-tag">REST API</span>
              <span class="tech-tag">Creative Automation</span>
            </div>
          </div>
          <div class="relative mt-2 md:mt-0 shrink-0">
            <a href={`${root}/video-automation`} class="btn-neon z-10 relative">
              <span>Case study</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>
        </div>
      </article>
    </div>

    <!-- Wszystkie repozytoria -->
    <div class="mt-16 reveal">
      <h3 class="text-xl font-bold text-white">Wszystkie repozytoria</h3>
      <p class="mt-2 text-sm text-slate-500">Kod, README i diagramy architektury. Wszystko publiczne.</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {repos.map((repo) => (
          <li>
            <a href={`${gh}/${repo.name}`} target="_blank" rel="noreferrer" class="repo-card group">
              <span class="flex items-center justify-between gap-3">
                <span class="font-mono text-sm font-semibold text-slate-200 group-hover:text-emerald-400 transition-colors break-all">{repo.name}</span>
                <span class="tech-tag shrink-0">{repo.lang}</span>
              </span>
              <span class="mt-2 block text-sm text-slate-400 leading-relaxed">{repo.desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ PO GODZINACH ═══ -->
  <div class="section-divider"></div>
  <section id="po-godzinach" class="mx-auto max-w-6xl px-4 py-20 md:py-28">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 reveal">
      <div>
        <p class="section-kicker">02 / Po godzinach</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Po godzinach: gry i zabawki</h2>
        <p class="mt-3 text-slate-400 max-w-3xl">Małe, dopracowane strony robione dla siebie i znajomych z ekipy. Jeden plik HTML, zero frameworków, a w środku ta sama dbałość o dane co w pracy: sprawdzone wzory, testy i działanie na telefonie.</p>
      </div>
      <a href={`${gh}/Gry`} target="_blank" rel="noreferrer" class="group flex shrink-0 items-center gap-2 text-sm font-semibold text-emerald-400 hover:text-white transition-colors">
        Repozytorium Gry
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {games.map((game, i) => (
        <article class={`game-card glass-card flex flex-col overflow-hidden group reveal reveal-delay-${i + 1}`} style={`--accent: ${game.accent}`}>
          <a href={game.href} class="block overflow-hidden border-b border-white/5" data-umami-event={`${game.event}_Obrazek`} tabindex="-1" aria-hidden="true">
            <Image src={game.img} alt="" widths={[480, 960]} sizes="(min-width: 768px) 33vw, 100vw" class="game-thumb w-full h-auto" />
          </a>
          <div class="flex flex-col flex-1 p-6">
            <p class="game-kicker">{game.kicker}</p>
            <h3 class="mt-1 font-bold text-xl text-white">{game.title}</h3>
            <p class="mt-2 text-sm text-slate-400 leading-relaxed flex-1">{game.desc}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {game.tags.map((tag) => <span class="tech-tag">{tag}</span>)}
            </div>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a href={game.href} class="btn-game" data-umami-event={game.event}>
                Otwórz
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              </a>
              <a href={game.code} target="_blank" rel="noreferrer" class="text-sm font-semibold text-slate-400 hover:text-white transition-colors">Kod →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ═══ W CZYM POMAGAM ═══ -->
  <div class="section-divider"></div>
  <section id="co-robie" class="mx-auto max-w-6xl px-4 py-20 md:py-28">
    <div class="mb-12 reveal">
      <p class="section-kicker">03 / Usługi</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">W czym pomagam</h2>
      <p class="mt-3 text-slate-400 max-w-2xl">Łączę systemy i buduję workflow, które oszczędzają czas. Do każdego zadania dobieram narzędzie, które pasuje najlepiej.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-3 md:grid-rows-2">
      <div class="md:col-span-2 glass-card-accent p-8 reveal reveal-delay-1">
        <h3 class="font-bold text-xl text-white flex items-center gap-3">
          <span class="text-2xl">✨</span> Integracja narzędzi AI
        </h3>
        <p class="mt-3 text-slate-300 leading-relaxed">Dobieram modele i narzędzia do zadania. Wdrażam asystentów, automatyzuję ekstrakcję informacji, klasyfikację danych, standaryzację promptów i generowanie treści, a potem wpinam to w procesy biznesowe przez workflow, webhooki i API.</p>
      </div>
      <div class="glass-card p-8 reveal reveal-delay-2">
        <h3 class="font-bold text-lg text-white">Marketing Automation</h3>
        <p class="mt-2 text-sm text-slate-400">Kampanie, harmonogramy i integracje API z narzędziami SaaS. Mniej powtarzalnych czynności w zespole.</p>
      </div>
      <div class="glass-card p-8 reveal reveal-delay-1">
        <h3 class="font-bold text-lg text-white">ETL i czyszczenie danych</h3>
        <p class="mt-2 text-sm text-slate-400">Dane z wielu źródeł w jednym, użytecznym modelu. Skrypty Python/Pandas do czyszczenia i mapowania.</p>
      </div>
      <div class="glass-card p-8 reveal reveal-delay-2">
        <h3 class="font-bold text-lg text-white">Backend i logika</h3>
        <p class="mt-2 text-sm text-slate-400">Mikroserwisy (FastAPI, Django, Express), webhooki do komunikacji między systemami i reguły scoringowe.</p>
      </div>
      <div class="glass-card p-8 reveal reveal-delay-3">
        <h3 class="font-bold text-lg text-white">Raportowanie i BI</h3>
        <p class="mt-2 text-sm text-slate-400">Dashboardy i KPI dla zarządu w Metabase. Automatyczne raporty, powiadomienia i jedno źródło prawdy.</p>
      </div>
    </div>
  </section>

  <!-- ═══ STACK ═══ -->
  <div class="section-divider"></div>
  <section id="stack" class="mx-auto max-w-6xl px-4 py-20 md:py-28">
    <div class="mb-12 reveal">
      <p class="section-kicker">04 / Narzędzia</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Stack technologiczny</h2>
      <p class="mt-3 text-slate-400 max-w-2xl">Narzędzia to tylko środek do celu, ale dobrze wiedzieć, co jest w skrzynce.</p>
    </div>
    <div class="grid gap-8 md:grid-cols-3 reveal">
      <div class="glass-card p-8">
        <h3 class="font-bold text-lg text-white mb-5 flex items-center gap-2">
          <span class="text-emerald-500">⚡</span> Automatyzacja
        </h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> n8n, Make i Zapier</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> Webhooki i integracje API</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> Airtable i SmartSuite</li>
        </ul>
      </div>
      <div class="glass-card p-8">
        <h3 class="font-bold text-lg text-white mb-5 flex items-center gap-2">
          <span class="text-emerald-500">💾</span> Backend i dane
        </h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> Python (Pandas, ETL)</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> Node.js, Django i FastAPI</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> PostgreSQL i SQL</li>
        </ul>
      </div>
      <div class="glass-card p-8">
        <h3 class="font-bold text-lg text-white mb-5 flex items-center gap-2">
          <span class="text-emerald-500">🛠️</span> Dev i prezentacja
        </h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> AI i LLM (prompt engineering)</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> Docker i GitHub Actions</li>
          <li class="flex items-center gap-3 text-slate-300 text-sm"><span class="badge-dot !w-1.5 !h-1.5"></span> HTML, Tailwind i Astro</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ JAK PRACUJĘ ═══ -->
  <div class="section-divider"></div>
  <section id="jak-pracuje" class="py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-16 max-w-4xl reveal">
        <p class="section-kicker">05 / Proces</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Jak pracuję</h2>
