---
import BaseLayout from '../layouts/BaseLayout.astro';
import NicponCat from '../components/NicponCat.astro';

const root = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="404 — Nicpoń zgubił tę stronę" description="Tej strony nie ma. Kot Nicpoń szuka jej pod biurkiem." noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 md:py-32 text-center">
    <p class="font-mono text-sm tracking-[0.3em] text-emerald-400/80 uppercase reveal">Błąd systemu</p>
    <h1 class="mt-4 font-mono font-black text-7xl md:text-9xl tracking-tighter neon-text reveal reveal-delay-1">404</h1>
    <p class="mt-4 text-xl text-slate-300 reveal reveal-delay-2">Nicpoń przeszukał wszystkie pipeline’y i tej strony nie ma.</p>
    <p class="mt-2 text-slate-500 reveal reveal-delay-2">Możliwe, że zrzucił ją z biurka w ramach testów chaosu.</p>

    <div class="mx-auto mt-12 w-full max-w-md reveal reveal-delay-3">
      <NicponCat autoType />
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-center gap-4 reveal reveal-delay-4">
      <a href={`${root}/`} class="btn-neon"><span>Wróć na start</span></a>
      <a href={`${root}/#projekty`} class="btn-ghost">Zobacz projekty</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Na 404 kotek przebiega od razu, żeby było weselej
  window.setTimeout(() => window.dispatchEvent(new Event('nicpon:run')), 2500);
</script>
