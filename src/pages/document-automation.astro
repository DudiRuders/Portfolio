---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import workflowImage from '../assets/workflow.png';
---

<BaseLayout title="Document Automation — Case Study | Mateusz Wienskowski">
  <main class="mx-auto max-w-4xl px-4 py-20 md:py-32">

    <div class="badge-neon mb-6 reveal"><span class="badge-dot"></span> Intelligent Automation • n8n • Microservices</div>

    <h1 class="text-4xl font-extrabold tracking-tight text-white reveal reveal-delay-1">
      Document <span class="neon-text">Automation Engine</span>
    </h1>

    <p class="mt-6 text-lg md:text-xl text-slate-400 leading-relaxed reveal reveal-delay-2">
      System oparty na mikroserwisach do masowego generowania dokumentów DOCX i PDF. Orkiestrator n8n zarządza przepływem danych, własne Render API obsługuje renderowanie szablonów, a całość zamknięta jest w Dockerze. Zero ręcznego "kopiuj-wklej", zero błędów typograficznych w kontraktach.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3 reveal reveal-delay-3">
      <a href="/Portfolio/" class="btn-ghost !px-6 !py-3">← Wróć</a>
      <a href="https://github.com/DudiRuders/document-automation-engine" target="_blank" rel="noreferrer" class="btn-neon !px-6 !py-3">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
        <span>Orchestrator (n8n)</span>
      </a>
      <a href="https://github.com/DudiRuders/document-render-service" target="_blank" rel="noreferrer" class="btn-ghost !px-5 !py-3 !text-sm">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
        Render API
      </a>
      <a href="https://github.com/DudiRuders/excel-to-docx-pipeline" target="_blank" rel="noreferrer" class="btn-ghost !px-5 !py-3 !text-sm">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
        Excel Demo
      </a>
    </div>

    <!-- Metryki -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 reveal">
      <div class="glass-card p-5 text-center"><div class="metric-value">3</div><div class="metric-label">osobne mikroserwisy</div></div>
      <div class="glass-card p-5 text-center"><div class="metric-value">3</div><div class="metric-label">endpointy Render API</div></div>
      <div class="glass-card p-5 text-center"><div class="metric-value">0</div><div class="metric-label">ręcznych kroków</div></div>
      <div class="glass-card p-5 text-center"><div class="metric-value">Docker</div><div class="metric-label">pełna przenośność</div></div>
    </div>

    <!-- Problem / Rozwiązanie -->
    <div class="mt-10 grid gap-6 md:grid-cols-2 reveal">
      <div class="glass-card p-8">
        <h2 class="text-xl font-bold text-white flex items-center gap-2"><span class="text-red-400">✕</span> Problem</h2>
        <ul class="mt-4 list-disc pl-5 space-y-2 text-slate-400">
          <li>Generowanie kontraktów, faktur i raportów wymagało ręcznego kopiowania danych do szablonu Word.</li>
          <li>Gotowe narzędzia no-code nie radziły sobie ze złożonym formatowaniem DOCX.</li>
          <li>Brak centralnego statusu dokumentów.</li>
          <li>Każda zmiana szablonu wymagała ręcznej aktualizacji wszystkich plików.</li>
        </ul>
      </div>
      <div class="glass-card-accent p-8">
        <h2 class="text-xl font-bold text-white flex items-center gap-2"><span class="text-emerald-400">✓</span> Rozwiązanie</h2>
        <ul class="mt-4 list-disc pl-5 space-y-2 text-slate-300">
          <li>Własne Render API w Node.js obsługujące dynamiczne szablony DOCX (Docxtemplater).</li>
          <li>n8n jako orkiestrator: nasłuchuje na zmiany statusu w Airtable, buduje payload JSON, wywołuje API.</li>
          <li>Trzy endpointy: renderowanie tekstu, podmiana obrazów, dodawanie pieczątek do PDF.</li>
          <li>Gotowy plik PDF trafia automatycznie na Google Drive, a URL wraca do Airtable.</li>
        </ul>
      </div>
    </div>

    <!-- Diagram -->
    <div class="mt-16 reveal">
      <h2 class="text-2xl font-bold text-white mb-4">Diagram przepływu (n8n)</h2>
      <div class="glass-card p-2 overflow-hidden">
        <Image src={workflowImage} alt="Diagram przepływu n8n" class="w-full rounded-xl border border-white/5" quality="high" />
      </div>
      <p class="mt-3 text-sm text-slate-500 text-center">Przepływ danych: Airtable trigger, mapowanie JSON, Render API, Google Drive, status sync.</p>
    </div>

    <!-- Architektura -->
    <div class="mt-16 reveal">
      <h2 class="text-2xl font-bold text-white">Architektura mikroserwisów</h2>
      <p class="mt-2 text-slate-500 text-sm">Trzy osobne repozytoria, trzy osobne odpowiedzialności</p>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="glass-card p-6">
          <div class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2 font-mono">Repo 1</div>
          <div class="font-semibold text-white mb-2">Orchestrator (n8n)</div>
          <div class="text-sm text-slate-400 leading-relaxed">Zarządza stanem, triggerami i dystrybucją plików.</div>
        </div>
        <div class="glass-card-accent p-6">
          <div class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2 font-mono">Repo 2</div>
          <div class="font-semibold text-white mb-2">Render API (Node.js)</div>
          <div class="text-sm text-slate-400 leading-relaxed">Samodzielny mikroserwis Express. Dockerizowany.</div>
        </div>
        <div class="glass-card p-6">
          <div class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2 font-mono">Repo 3</div>
          <div class="font-semibold text-white mb-2">Excel Pipeline (demo)</div>
          <div class="text-sm text-slate-400 leading-relaxed">Demonstracja pipeline'u na danych Excel.</div>
        </div>
      </div>
    </div>

    <!-- Endpointy API -->
    <div class="mt-16 reveal">
      <h2 class="text-2xl font-bold text-white">Endpointy Render API</h2>
      <div class="mt-6 overflow-x-auto glass-card !rounded-xl">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-white/5 bg-white/[0.02]">
              <th class="px-4 py-3 text-left font-semibold text-slate-300">Endpoint</th>
              <th class="px-4 py-3 text-left font-semibold text-slate-300">Opis</th>
              <th class="px-4 py-3 text-left font-semibold text-slate-300">Output</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <tr><td class="px-4 py-3 font-mono text-xs text-emerald-400">POST /render</td><td class="px-4 py-3 text-slate-400">Wypełnia placeholdery danymi, obsługuje dynamiczne tabele i listy.</td><td class="px-4 py-3 text-slate-400">Plik .docx</td></tr>
            <tr><td class="px-4 py-3 font-mono text-xs text-emerald-400">POST /replace-image</td><td class="px-4 py-3 text-slate-400">Podmienia placeholdery graficzne: QR kody, logo, podpisy.</td><td class="px-4 py-3 text-slate-400">Plik .docx z obrazami</td></tr>
            <tr><td class="px-4 py-3 font-mono text-xs text-emerald-400">POST /stamp</td><td class="px-4 py-3 text-slate-400">Nakłada cyfrową pieczątkę lub watermark na gotowy PDF.</td><td class="px-4 py-3 text-slate-400">Plik .pdf</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Payload JSON -->
    <div class="mt-16 reveal">
      <h2 class="text-2xl font-bold text-white">Przykładowy payload JSON</h2>
      <p class="mt-2 text-slate-500 text-sm">Dane wysyłane przez n8n do Render API przy generowaniu kontraktu B2B</p>
      <div class="mt-6 code-window">
        <div class="code-window-header">
          <div class="code-window-dots"><span></span><span></span><span></span></div>
          <span class="code-window-title">payload_example.json</span>
        </div>
        <pre class="p-5 text-sm font-mono leading-relaxed text-slate-300 overflow-x-auto"><code><span class="text-slate-500">// Payload budowany przez n8n i wysyłany do POST /render</span>
&#123;
  <span class="text-emerald-400">"template_id"</span>: <span class="text-yellow-300">"b2b_contract_v2"</span>,
  <span class="text-emerald-400">"data"</span>: &#123;
    <span class="text-emerald-400">"client_name"</span>:     <span class="text-yellow-300">"Tech Corp LLC"</span>,
    <span class="text-emerald-400">"contract_date"</span>:   <span class="text-yellow-300">"2025-03-01"</span>,
    <span class="text-emerald-400">"contract_value"</span>:  <span class="text-yellow-300">"15 000,00 PLN"</span>,
    <span class="text-emerald-400">"services"</span>: [
      &#123; <span class="text-emerald-400">"name"</span>: <span class="text-yellow-300">"API Integration"</span>,  <span class="text-emerald-400">"price"</span>: <span class="text-yellow-300">"10 000 PLN"</span> &#125;,
      &#123; <span class="text-emerald-400">"name"</span>: <span class="text-yellow-300">"Maintenance (12m)"</span>, <span class="text-emerald-400">"price"</span>: <span class="text-yellow-300">"5 000 PLN"</span>  &#125;
    ]
  &#125;,
  <span class="text-emerald-400">"output_format"</span>: <span class="text-yellow-300">"pdf"</span>,
  <span class="text-emerald-400">"upload_to_drive"</span>: <span class="text-purple-400">true</span>
&#125;</code></pre>
      </div>
    </div>

    <!-- Wnioski -->
    <div class="mt-16 glass-card p-8 reveal">
      <h2 class="text-xl font-bold text-white">Czego się nauczyłem</h2>
      <p class="mt-4 text-slate-400 leading-relaxed">
        Główna lekcja to granica między tym, co powinno być w orkiestratorze, a co w osobnym serwisie. Pierwotnie próbowałem renderować DOCX bezpośrednio w węźle n8n przez skrypt. Przy złożonych szablonach z tabelami i obrazami to się nie skalowało. Wydzielenie renderowania do osobnego API z własnym Dockerem rozwiązało problem i przy okazji dało możliwość użycia tego serwisu przez inne systemy niezależnie od n8n. Separacja odpowiedzialności to nie teoria z książki, to coś co poczułem na konkretnym problemie.
      </p>
    </div>

    <!-- Stack -->
    <div class="mt-12 pt-10 reveal">
      <div class="section-divider mb-10"></div>
      <h2 class="text-2xl font-bold text-white">Wykorzystany Stack</h2>
      <div class="mt-6 flex flex-wrap gap-2">
        <span class="tech-tag">n8n</span><span class="tech-tag">Node.js</span><span class="tech-tag">Express</span>
        <span class="tech-tag">Docxtemplater</span><span class="tech-tag">pdf-lib</span><span class="tech-tag">REST API</span>
        <span class="tech-tag">Airtable</span><span class="tech-tag">Google Drive API</span><span class="tech-tag">Docker</span>
      </div>
    </div>

  </main>
</BaseLayout>
